# Copy to docker/.env on the NAS and adjust. Compose reads it automatically;
# .env is gitignored so your paths survive a git pull.

# Shared folder names differ per NAS — this is the one people have to change.
BACKUPBOT_BACKUPS_PATH=/volume1/backups/databases

# SQLite state, encryption key and run logs.
BACKUPBOT_DATA_PATH=/volume1/docker/backupbot/data

# The scheduler evaluates cron expressions in this zone.
BACKUPBOT_TZ=Europe/Madrid

# Optional: post every backup result to a Discord channel. Server Settings →
# Integrations → Webhooks → New Webhook → Copy Webhook URL.
# Channels added through the CLI/API are used as well as this one.
# BACKUPBOT_DISCORD_WEBHOOK=https://discord.com/api/webhooks/123456789/abcdef

# Which results to report: success, failed, cancelled, or all.
# BACKUPBOT_NOTIFY_EVENTS=success,failed
